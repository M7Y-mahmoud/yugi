{
  "rules": {
    "cards": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$cardId": {
        ".validate": "newData.hasChildren(['name', 'imageUrl', 'type', 'description'])",
        "name": {
          ".validate": "newData.isString()"
        },
        "imageUrl": {
          ".validate": "newData.isString()"
        },
        "type": {
          ".validate": "newData.val() == 'Monster' || newData.val() == 'Spell' || newData.val() == 'Trap'"
        },
        "description": {
          ".validate": "newData.isString()"
        },
        "atk": {
          ".validate": "!newData.exists() || newData.isNumber()"
        },
        "def": {
          ".validate": "!newData.exists() || newData.isNumber()"
        },
        "level": {
          ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 1 && newData.val() <= 12)"
        }
      }
    },

    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).child('role').val() === 'superadmin'",
      ".write": "auth != null && root.child('admins').child(auth.uid).child('role').val() === 'superadmin'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).child('role').val() === 'superadmin')"
      }
    },

    "activityLogs": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$logId": {
        ".write": "auth != null && root.child('admins').child(auth.uid).exists() && !data.exists()",
        ".validate": "newData.hasChildren(['adminId', 'action', 'timestamp'])",
        "adminId": {
          ".validate": "newData.val() === auth.uid"
        }
      }
    },

    "users": {
      ".read": "auth != null",
      ".indexOn": ["username"],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "decks": {
      "$deckId": {
        ".read": "auth != null && (data.child('ownerId').val() === auth.uid || data.child('visibility').val() === 'public' || !data.exists())",
        ".write": "auth != null && (!data.exists() || data.child('ownerId').val() === auth.uid)"
      }
    },

    "favorites": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "friendRequests": {
      ".read": "auth != null",
      ".indexOn": ["fromUid", "toUid", "status"],
      "$requestId": {
        ".read": "auth != null && (data.child('fromUid').val() === auth.uid || data.child('toUid').val() === auth.uid || !data.exists())",
        ".write": "auth != null && ((!data.exists() && newData.child('fromUid').val() === auth.uid && newData.child('status').val() === 'pending') || (data.exists() && data.child('toUid').val() === auth.uid && (newData.child('status').val() === 'accepted' || newData.child('status').val() === 'rejected')) || (data.exists() && data.child('fromUid').val() === auth.uid && data.child('status').val() === 'pending' && (!newData.exists() || newData.child('status').val() === 'rejected')))"
      }
    },

    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$friendUid": {
          ".read": "auth != null && (auth.uid === $uid || auth.uid === $friendUid)",
          ".write": "auth != null && (auth.uid === $uid || auth.uid === $friendUid)"
        }
      }
    },

    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$notifId": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && (auth.uid === $uid || (!data.exists() && newData.exists()))"
        }
      }
    },

    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "games": {
      "$gameId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
